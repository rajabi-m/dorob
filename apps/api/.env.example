# Development-only values matching root compose.yaml. Never use these in production.
DATABASE_URL=postgres://dorob:dorob_dev@127.0.0.1:5432/dorob
HOST=127.0.0.1
PORT=3001

# Persistent directories, relative to apps/api unless absolute; keep separate.
THUMBNAIL_ASSET_DIR=storage/thumbnails
THUMBNAIL_STAGING_DIR=storage/staging

# Thumbnail downloads use verified standard HTTPS with DNS/redirect preflight.
# IP pinning is temporarily deferred: accepted SSRF/DNS rebinding risk.
# TODO: restore verified connection pinning; see docs/catalog.md.

# Protection is enabled by default; explicit trusted local bypass only:
DOROB_DEV_MODE=false
# Optional absolute path; default: apps/api/storage/auth beneath workspace root.
# DOROB_AUTH_DIR=/absolute/private/path/auth
