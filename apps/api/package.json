{
  "name": "@dorob/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "start": "bun dist/index.js",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc -p tsconfig.json",
    "test": "bun test tests"
  },
  "dependencies": {
    "@elysia/openapi": "1.4.16",
    "elysia": "1.4.30",
    "swagger-ui-dist": "5.33.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
