{
  "name": "@dorob/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts src/raster-worker.ts --target bun --external sharp --outdir dist",
    "start": "bun dist/index.js",
    "lint": "bun --bun eslint .",
    "typecheck": "bun --bun tsc -p tsconfig.json",
    "test": "bun test tests",
    "migrate": "bun src/migrate.ts"
  },
  "dependencies": {
    "@dorob/core": "workspace:*",
    "@elysia/openapi": "1.4.16",
    "@sinclair/typebox": "0.34.41",
    "elysia": "1.4.30",
    "sharp": "0.34.5",
    "swagger-ui-dist": "5.33.1",
    "@dorob/embedding-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
