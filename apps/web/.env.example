# Server-only backend origin; browser requests use the web origin.
DOROB_API_URL=http://127.0.0.1:3001

# Must match API configuration and share its private credential directory.
DOROB_DEV_MODE=false
# DOROB_AUTH_DIR=/absolute/private/path/auth
# Required for hosted HTTPS and trusted mutation-origin checks:
# DOROB_WEB_ORIGIN=https://your-domain.example
