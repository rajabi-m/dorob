{
  "name": "dorob",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint && bun run --cwd apps/utils lint",
    "typecheck": "bun run --cwd apps/web typecheck && bun run typecheck:utils",
    "typecheck:utils": "bun run --cwd apps/utils typecheck",
    "test:utils": "bun test apps/utils/tests",
    "scrape:maktabkhooneh": "bun run apps/utils/scrape-maktabkhooneh.ts",
    "scrape:toplearn": "bun run apps/utils/scrape-toplearn.ts",
    "scrape:sabzlearn": "bun run apps/utils/scrape-sabzlearn.ts",
    "scrape:roocket": "bun run apps/utils/scrape-roocket.ts",
    "dashboard:aggregate": "bun run apps/utils/aggregate-courses.ts",
    "dashboard:data": "bun run apps/utils/data-dashboard.ts"
  }
}
