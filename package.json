{
  "name": "dorob",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint && bun run --cwd apps/utils lint && bun run lint:api",
    "typecheck": "bun run --cwd apps/web typecheck && bun run typecheck:utils && bun run typecheck:api",
    "dev:api": "bun run --cwd apps/api dev",
    "build:api": "bun run --cwd apps/api build",
    "start:api": "bun run --cwd apps/api start",
    "test:api": "bun run --cwd apps/api test",
    "lint:api": "bun run --cwd apps/api lint",
    "typecheck:api": "bun run --cwd apps/api typecheck",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "typecheck:utils": "bun run --cwd apps/utils typecheck",
    "test:utils": "bun test apps/utils/tests",
    "scrape:maktabkhooneh": "bun run apps/utils/scrape-maktabkhooneh.ts",
    "db:migrate": "bun run --cwd apps/api migrate",
    "convert:courses": "bun run apps/utils/convert-course-v3.ts",
    "ingest:maktabkhooneh": "bun run apps/utils/ingest-maktabkhooneh.ts",
    "ingest:sabzlearn": "bun run apps/utils/ingest-sabzlearn.ts",
    "ingest:roocket": "bun run apps/utils/ingest-roocket.ts",
    "ingest:toplearn": "bun run apps/utils/ingest-toplearn.ts",
    "dev:lab": "bun run --cwd apps/embedding-lab dev",
    "start:lab": "bun run --cwd apps/embedding-lab start",
    "build:lab": "bun run --cwd apps/embedding-lab build",
    "lint:lab": "bun run --cwd apps/embedding-lab lint",
    "typecheck:lab": "bun run --cwd apps/embedding-lab typecheck",
    "test:lab": "bun run --cwd apps/embedding-lab test",
    "lab": "bun run --cwd apps/embedding-lab cli",
    "worker:embeddings": "bun apps/embedding-worker/src/cli.ts",
    "build:embedding-worker": "bun run --cwd apps/embedding-worker build",
    "test:embedding-worker": "bun run --cwd apps/embedding-worker test",
    "typecheck:embedding-worker": "bun run --cwd apps/embedding-worker typecheck",
    "lint:embedding-worker": "bun run --cwd apps/embedding-worker lint",
    "test:embedding-engine": "bun run --cwd packages/embedding-engine test"
  }
}
