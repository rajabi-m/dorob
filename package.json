{
  "name": "dorob",
  "private": true,
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint && bun run --cwd apps/utils lint && bun run lint:backend",
    "typecheck": "bun run --cwd apps/web typecheck && bun run typecheck:utils && bun run typecheck:backend",
    "typecheck:utils": "bun run --cwd apps/utils typecheck",
    "test:utils": "bun test apps/utils/tests",
    "scrape:maktabkhooneh": "bun run apps/utils/scrape-maktabkhooneh.ts",
    "scrape:toplearn": "bun run apps/utils/scrape-toplearn.ts",
    "scrape:sabzlearn": "bun run apps/utils/scrape-sabzlearn.ts",
    "scrape:roocket": "bun run apps/utils/scrape-roocket.ts",
    "dashboard:aggregate": "bun run apps/utils/aggregate-courses.ts",
    "dashboard:data": "bun run apps/utils/data-dashboard.ts",
    "lint:backend": "bun --bun eslint -c eslint.backend.config.mjs apps/backend apps/worker packages",
    "typecheck:backend": "bun --bun tsc -p tsconfig.backend.json",
    "test:backend": "bun test apps/backend/tests",
    "test:backend:integration": "bun run apps/backend/tests/run-integration.ts",
    "build:backend": "bun run --cwd apps/backend build && bun run --cwd apps/worker build",
    "dev:backend": "bun run apps/backend/src/index.ts",
    "worker": "bun run apps/worker/src/index.ts",
    "backend:cli": "bun run apps/backend/src/cli.ts",
    "db:generate": "bun --bun run --cwd packages/db drizzle-kit generate",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "db:up": "docker compose up -d --wait db",
    "queue:setup": "bun run apps/backend/src/cli.ts queue-setup",
    "dashboard:queue": "docker compose --profile ops up -d --build dashboard",
    "test:backend:containers": "bun run apps/backend/tests/run-container-smoke.ts",
    "test:web": "bun test apps/web/tests"
  },
  "devDependencies": {
    "@types/bun": "1.3.8",
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "typescript-eslint": "8.71.0"
  }
}
