# Copy to .env for local use. Real .env files are ignored and excluded from images.
# Percent-encode reserved characters in database passwords inside DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgres://dorob:replace-with-a-long-random-database-password@127.0.0.1:5432/dorob
DATABASE_POOL_SIZE=5
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4000
# Generate locally: openssl rand -hex 32. Optional; internal HTTP access is denied without it.
BACKEND_OPERATOR_TOKEN=
PGBOSS_SCHEMA=pgboss
WORKER_CONCURRENCY=1
PROVIDER_CONCURRENCY=1
JEV_CONCURRENCY=1
GENERATIVE_CONCURRENCY=1
SCHEDULES_ENABLED=false
LIVE_MODEL_CALLS_ENABLED=false
# Manual model calls require explicit enablement, credentials, model IDs and bounded database run budgets.
# Schedules and generative work remain disabled. Jev + embeddings share one PostgreSQL call slot.
OPENROUTER_API_KEY=
JEV_MODEL_ID=
GENERATIVE_MODEL_ID=
EMBEDDING_MODEL_ID=
# Leave BOTH model and dimensions unset until a model is selected.
EMBEDDING_DIMENSIONS=
MODEL_MAX_OUTPUT_TOKENS=2000
# Worker ceiling: each live database run must fit this USD bound.
# A run also requires maxCalls and a conservative perCallUsd reservation via model-budget.
MODEL_RUN_BUDGET_USD=
# Private dashboard container (Node). Set both before starting the ops profile.
PGBOSS_DASHBOARD_AUTH_USERNAME=operator
PGBOSS_DASHBOARD_AUTH_PASSWORD=

# Shared database policy only increases; includes public API and robots requests.
PROVIDER_REQUEST_SPACING_MS=1500
